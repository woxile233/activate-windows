[Variables]
LANGUAGE=zh-CN

; 小型皮肤窗口尺寸（不懂的话尽量别动）
W=300
H=58

; 相对于 Windows 工作区右下角的位置
; RightMargin是指水印距离屏幕右侧的距离
; BottomMargin是指水印距离底部任务栏（注意是*任务栏*）的距离
; 我的屏幕分辨率是2560x1600（16：10比例），显示缩放开的175%（如果开了显示缩放字显示发糊的话可以去属性-兼容性-更改高DPI设置里勾选替代高 DPI 缩放行为。缩放执行：应用程序）
RightMargin=340
BottomMargin=155

; 文字在皮肤窗口中的局部坐标（不懂的话尽量别动）
FirstLineX=0
FirstLineY=0
